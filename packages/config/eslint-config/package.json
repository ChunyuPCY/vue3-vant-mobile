{
  "name": "@vue3-vant-mobile/eslint-config",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint config for vue3-vant-mobile monorepo",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "stub": "tsdown --watch"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "eslint": "catalog:lint"
  },
  "devDependencies": {
    "@vue3-vant-mobile/tsconfig": "workspace:*",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
