{
  "name": "vue3-vant-mobile-monorepo",
  "type": "module",
  "version": "3.15.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "A monorepo template based on Vue 3 ecosystem for mobile web apps",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:pro": "turbo run build:pro",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,vue,md,json}\"",
    "release": "bumpp --commit --push --tag",
    "commitlint": "commitlint --edit",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@commitlint/cli": "catalog:git",
    "@commitlint/config-conventional": "catalog:git",
    "@commitlint/types": "catalog:git",
    "bumpp": "catalog:git",
    "eslint": "catalog:lint",
    "lint-staged": "catalog:git",
    "prettier": "catalog:lint",
    "simple-git-hooks": "catalog:git",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "pnpm commitlint $1"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
