{
  "name": "@vue3-vant-mobile/web",
  "type": "module",
  "version": "3.15.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "description": "A mobile web app based on Vue 3 ecosystem",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "cross-env MOCK_SERVER_PORT=8086 vite",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "build:pro": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@unhead/vue": "catalog:prod",
    "@vant/touch-emulator": "catalog:prod",
    "@vant/use": "catalog:prod",
    "@vueuse/core": "catalog:prod",
    "axios": "catalog:prod",
    "echarts": "catalog:prod",
    "lodash-es": "catalog:prod",
    "nprogress": "catalog:prod",
    "pinia": "catalog:prod",
    "pinia-plugin-persistedstate": "catalog:prod",
    "resize-detector": "catalog:prod",
    "vant": "catalog:prod",
    "vconsole": "catalog:prod",
    "vue": "catalog:prod",
    "vue-i18n": "catalog:prod",
    "vue-router": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@iconify-json/carbon": "catalog:dev",
    "@intlify/unplugin-vue-i18n": "catalog:dev",
    "@types/lodash-es": "catalog:frontend",
    "@types/node": "catalog:frontend",
    "@types/nprogress": "catalog:frontend",
    "@unocss/eslint-config": "catalog:lint",
    "@vant/auto-import-resolver": "catalog:dev",
    "@vitejs/plugin-legacy": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vue3-vant-mobile/eslint-config": "workspace:*",
    "@vue3-vant-mobile/tsconfig": "workspace:*",
    "autoprefixer": "catalog:frontend",
    "cross-env": "catalog:frontend",
    "eslint": "catalog:lint",
    "eslint-plugin-format": "catalog:lint",
    "less": "catalog:frontend",
    "mockjs": "catalog:frontend",
    "postcss-mobile-forever": "catalog:frontend",
    "typescript": "catalog:dev",
    "unocss": "catalog:dev",
    "unplugin-auto-import": "catalog:dev",
    "unplugin-vue-components": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plugin-mock-dev-server": "catalog:dev",
    "vite-plugin-pwa": "catalog:dev",
    "vite-plugin-sitemap": "catalog:dev",
    "vite-plugin-vconsole": "catalog:dev",
    "vite-plugin-vue-devtools": "catalog:dev",
    "vue-tsc": "catalog:dev"
  }
}
